generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Audio {
  id                String  @id // never use bigint on this
  name              String
  category          String
  whitelisterName   String
  whitelisterUserId BigInt
  whitelisterType   String
  private           Boolean @default(false)
  audioUrl          String?

  version    Int      @default(2)
  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @default(now()) @db.Timestamptz()
}

model Audios {
  id       BigInt @id
  name     String
  category String

  is_previewable Boolean @default(true)
  audio_url      String?

  requester        Json            @default("{ \"discord\": { \"id\": null, \"username\": null }, \"roblox\": { \"id\": null, \"username\": null } }")
  whitelister      Json            @default("{ \"discord\": { \"id\": null, \"username\": null }, \"roblox\": { \"id\": null, \"username\": null } }")
  audio_lifecycle  AudioLifecycle  @default(ACTIVE)
  audio_visibility AudioVisibility @default(PUBLIC)

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @default(now()) @db.Timestamptz()

  @@map("audios")
}

model User {
  id        String   @id @default(cuid())
  robloxId  String   @unique
  username  String
  avatar    String?
  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  sessions           Session[]
  oauthTokens        OAuthToken[]
  whitelist_requests WhitelistRequest[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime @db.Timestamptz()
  createdAt DateTime @default(now()) @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model OAuthToken {
  id           String    @id @default(cuid())
  userId       String
  provider     String // "roblox"
  accessToken  String
  refreshToken String?
  expiresAt    DateTime? @db.Timestamptz()
  scope        String?
  createdAt    DateTime  @default(now()) @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("oauth_tokens")
}

model WhitelistRequest {
  request_id String @id @default(cuid())
  audio_id   String
  name       String
  category   String

  audio_visibility AudioVisibility        @default(PUBLIC)
  status           WhitelistRequestStatus @default(PENDING)
  created_at       DateTime               @default(now()) @db.Timestamptz()
  updatedAt        DateTime               @updatedAt @db.Timestamptz()
  audio_url        String
  acknowledged Boolean @default(false)

  requester Json

  userId String
  User   User   @relation(fields: [userId], references: [id])

  @@map("whitelist_requests")
}

enum AudioLifecycle {
  ACTIVE
  MODERATED
}

enum AudioVisibility {
  PUBLIC
  PRIVATE
}

enum WhitelistRequestStatus {
  PENDING
  APPROVED
  REJECTED
}
