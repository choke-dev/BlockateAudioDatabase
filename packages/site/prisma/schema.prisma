generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Audio {
  id                String @id // never use bigint on this
  name              String
  category          String
  whitelisterName   String
  whitelisterUserId BigInt
  whitelisterType   String
  private           Boolean @default(false)
  audioUrl          String?

  version Int @default(2)
  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @default(now()) @db.Timestamptz()
}

model Audios {
  id        BigInt @id
  name      String
  category  String

  is_previewable Boolean @default(true)
  audio_url  String?

  requester Json // { "discord": { id: string, username: string }, "roblox": { id: string, username: string } }
  whitelister Json // { "discord": { id: string, username: string }, "roblox": { id: string, username: string } }

  audio_lifecycle AudioLifecycle @default(ACTIVE)
  audio_visibility AudioVisibility @default(PUBLIC)

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @default(now()) @db.Timestamptz()

  @@map("audios")
}

model User {
  id        String   @id @default(cuid())
  robloxId  String   @unique
  username  String
  avatar    String?
  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  sessions         Session[]
  oauthTokens      OAuthToken[]
  whitelistRequests WhitelistRequest[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime @db.Timestamptz()
  createdAt DateTime @default(now()) @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model OAuthToken {
  id           String    @id @default(cuid())
  userId       String
  provider     String    // "roblox"
  accessToken  String
  refreshToken String?
  expiresAt    DateTime? @db.Timestamptz()
  scope        String?
  createdAt    DateTime  @default(now()) @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("oauth_tokens")
}


model WhitelistRequest {
  id        String   @id @default(cuid())
  audioId   String
  name      String
  category  String

  private   Boolean @default(false)
  status    WhitelistRequestStatus @default(PENDING)
  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  requestedById String
  requestedBy   User @relation(fields: [requestedById], references: [id])
  
  @@map("whitelist_requests")
}

enum AudioLifecycle {
  ACTIVE
  MODERATED
}

enum AudioVisibility {
  PUBLIC
  PRIVATE
}

enum WhitelistRequestStatus {
  PENDING
  APPROVED
  REJECTED
}